# Never commit real credentials. Use a long random value in deployed environments.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required for deployment: Neon pooled Postgres URL with sslmode=require.
DATABASE_URL=
# Use a PRIVATE Vercel Blob store. The token must stay on the backend.
BLOB_READ_WRITE_TOKEN=
# Local-only, explicit offline development option. Deployment refuses this.
DOCUMENT_STORAGE=local
SEED_ALEX_PASSWORD=
SEED_JAMIE_PASSWORD=
SEED_REVIEWER_PASSWORD=
## Public assignment demo (dedicated accounts; never exposes ordinary submissions)
DEMO_ENABLED=1
